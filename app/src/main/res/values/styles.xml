<?xml version="1.0" encoding="utf-8"?>
<!--
  공통 스타일. 값은 피그마 「FULL SERVICE FLOW v2」 DS/Board v2 그대로:
    화면 제목 24 Bold/132% (어르신 26/134%) · 섹션 라벨 14 Bold #525C6E · 본문 16/150%
    Primary 버튼 342×56 · r12 · 17 Bold 흰 글자 (어르신 66 · r14 · 19 Bold)
    Secondary 버튼 동일 규격 · #EEF1F5 바탕 · 16 Medium #39414F
    카드 #F5F7FA · r16 (어르신 18~20) · 좌우 여백 24
-->
<resources>

    <!--
      앱 전체 테마. 시안이 흰 바탕이라 라이트 테마 고정 —
      다크 모드 미추종: 어르신 폰이 다크 모드면 흰 카드에 흰 글씨 사고 발생
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light">
        <item name="android:colorPrimary">@color/mint</item>
        <item name="android:colorAccent">@color/mint</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_soft</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <!--
          안드로이드 기본 상단 막대 미사용. 시안의 모든 화면은 뒤로 화살표·제목을
          화면 안에 직접 그리는 구조 (앱바 제목 y=62 · 20 Bold)
        -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:actionBarStyle">@style/AppActionBar</item>
        <!-- 시안 글꼴 Noto Sans KR. 미지정 시 삼성폰은 One UI Sans로 렌더되어 인상 차이 발생 -->
        <item name="android:fontFamily">@font/noto</item>
    </style>

    <style name="AppActionBar" parent="@android:style/Widget.Material.Light.ActionBar.Solid">
        <item name="android:background">@color/bg</item>
        <item name="android:titleTextStyle">@style/AppActionBarTitle</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="AppActionBarTitle" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/noto</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Primary 버튼 (보호자): 56dp · r12 · 17 Bold · 흰 글자 -->
    <style name="BigButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_width">match_parent</item>
        <!-- 높이 고정(글자 의존 없음). 한글 글꼴은 위아래 여백이 커서
             padding 기준이면 폰마다 차이 발생 -->
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/btn_mint</item>
        <item name="android:textColor">@color/on_mint</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/noto</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Primary 버튼 (어르신): 66dp · r14 · 19 Bold -->
    <style name="SeniorButton" parent="BigButton">
        <item name="android:layout_height">66dp</item>
        <item name="android:background">@drawable/btn_mint_senior</item>
        <item name="android:textSize">19sp</item>
    </style>

    <!-- Secondary 버튼 — #EEF1F5 바탕 · 16 Medium · #39414F -->
    <style name="LineButton" parent="BigButton">
        <item name="android:background">@drawable/btn_line</item>
        <item name="android:textColor">@color/btn_secondary_ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/noto_sans_kr_medium</item>
    </style>

    <style name="SeniorLineButton" parent="LineButton">
        <item name="android:layout_height">66dp</item>
        <item name="android:background">@drawable/btn_line_senior</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- 알약 버튼 (전화하기 / 메시지): 높이 52dp · 완전 원형 모서리 -->
    <style name="PillButton" parent="BigButton">
        <item name="android:background">@drawable/btn_pill</item>
        <item name="android:layout_height">52dp</item>
    </style>

    <style name="PillLineButton" parent="PillButton">
        <item name="android:background">@drawable/btn_pill_line</item>
        <item name="android:textColor">@color/btn_secondary_ink</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/noto_sans_kr_medium</item>
    </style>

    <!-- 화면 제목 (보호자) 24 Bold / 132% -->
    <style name="TitleBig">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/noto</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:lineHeight">32sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 화면 제목 (어르신) 26 Bold / 134% -->
    <style name="TitleSenior" parent="TitleBig">
        <item name="android:textSize">26sp</item>
        <item name="android:lineHeight">35sp</item>
    </style>

    <!-- 부제 · 설명 16 Regular / 150% -->
    <style name="TitleSub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/noto</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:lineHeight">24sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 섹션 라벨 14 Bold · #525C6E -->
    <style name="SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/noto</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 앱바 제목 20 Bold (뒤로 화살표 옆) -->
    <style name="AppBarTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/noto</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 리스트 항목: 제목 16.5 Bold + 설명 13.5 Regular -->
    <style name="ItemTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/noto</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="ItemDesc">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:fontFamily">@font/noto</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:lineHeight">19sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="ScreenTitle" parent="TitleBig" />

    <style name="ScreenBody" parent="TitleSub" />

    <style name="FieldLabel" parent="ScreenBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink_soft</item>
    </style>

    <!-- 숫자를 크게 넣는 입력칸 (가족 아이디·비밀번호·전화번호) -->
    <style name="BigField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/field_box</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/noto</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_muted</item>
    </style>
</resources>
