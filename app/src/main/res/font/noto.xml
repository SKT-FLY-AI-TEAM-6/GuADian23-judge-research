<?xml version="1.0" encoding="utf-8"?>
<!--
  글꼴 한 벌 (Noto Sans KR).

  굵기 파일 분리 이유: Regular 하나에 `textStyle="bold"`면 안드로이드가 **가짜 굵게** 생성 —
  획을 옆으로 번지게 하는 방식이라 진짜 Bold보다 뭉툭하고 자간이 벌어져 시안과 인상 차이.
  700(Bold)·500(Medium) 실제 파일 포함.

  각 파일: 가변 글꼴에서 해당 굵기만 추출, 한글 음절·라틴·기호만 유지 (약 2.8MB)
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/noto_sans_kr"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/noto_sans_kr_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/noto_sans_kr_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
