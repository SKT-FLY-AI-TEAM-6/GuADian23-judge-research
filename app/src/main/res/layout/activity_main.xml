<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="광고 알리미"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="광고가 보이면 표시하고, 광고가 데려간 곳이 위험한지 확인해 드립니다.\n광고를 막거나 숨기지 않습니다."
            android:textSize="14sp" />

        <TextView
            android:id="@+id/text_family"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#555555"
            android:textSize="14sp" />

        <Button
            style="@style/LineButton"
            android:id="@+id/btn_family"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="가족 계정 연결하기" />

        <Button
            style="@style/BigButton"
            android:id="@+id/btn_guardian"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="18dp"
            android:text="보호 현황 보기"
            android:textSize="19sp"
            android:visibility="gone" />

        <Button
            style="@style/LineButton"
            android:id="@+id/btn_protection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="14dp"
            android:text="보호 수준 설정"
            android:textSize="17sp"
            android:visibility="gone" />

        <Button
            style="@style/LineButton"
            android:id="@+id/btn_report"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="14dp"
            android:text="주간 안전 리포트"
            android:textSize="17sp"
            android:visibility="gone" />

        <Button
            style="@style/LineButton"
            android:id="@+id/btn_alerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="14dp"
            android:text="알림과 허용 목록"
            android:textSize="17sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/group_senior"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                style="@style/LineButton"
                android:id="@+id/btn_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="14dp"
                android:text="이번 주 안심 요약"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/text_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                style="@style/BigButton"
                android:id="@+id/btn_accessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="접근성 권한 설정 열기" />

            <Switch
                android:id="@+id/switch_visual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingVertical="10dp"
                android:text="👁 시각 경고 (화면 테두리 + 광고 배지)"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/switch_sound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:text="🔔 청각 경고 (알림음)"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/switch_vibe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:text="📳 진동 경고"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
