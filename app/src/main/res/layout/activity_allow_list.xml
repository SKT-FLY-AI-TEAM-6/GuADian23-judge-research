<?xml version="1.0" encoding="utf-8"?>
<!--
  13G-2 · 허용 목록 관리 (피그마 v2 · 1234:10).
  앱바(뒤로 44 · 제목 20 Bold) → 안내 두 줄 → 세그먼트(앱/사이트) → 구역 이름 →
  목록 카드(줄 + 점선 추가) → 안내 카드 → CTA 56. 목록은 AllowListActivity가 그린다
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="7dp"
            android:contentDescription="뒤로"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/AppBarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="52dp"
            android:text="허용 목록 관리" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="10dp"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="-0.015"
                android:lineHeight="21sp"
                android:text="허용 목록 내 앱·사이트에서는 광고 표시와 이동 확인을 하지 않아요"
                android:textColor="@color/ink_soft"
                android:textSize="14.5sp" />

            <!-- 세그먼트: AllowListActivity에서 채움 -->
            <LinearLayout
                android:id="@+id/segment"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:padding="4dp" />

            <TextView
                android:id="@+id/text_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:includeFontPadding="false"
                android:letterSpacing="-0.015"
                android:text="항상 허용한 앱"
                android:textColor="@color/ink_soft"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/list_allow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="18dp">

                <TextView
                    android:id="@+id/text_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.015"
                    android:lineHeight="21sp"
                    android:textColor="@color/ink_soft"
                    android:textSize="13.5sp" />

                <!-- 이 화면에서 가장 중요한 한 줄 — 허용해도 차단은 그대로다 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.015"
                    android:text="차단은 허용 목록과 관계없이 항상 작동해요"
                    android:textColor="@color/mint"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_save"
        style="@style/BigButton"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:text="변경 내용 저장" />
</LinearLayout>
