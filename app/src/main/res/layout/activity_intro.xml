<?xml version="1.0" encoding="utf-8"?>
<!--
  00 · 서비스 소개 (피그마 v2 · 1035:8). 앱 첫 실행 시 화면.
  피그마 값: 로고 줄(41×42 + 워드마크 20 #0A1A33) · 제목 28 Bold/132% · 부제 16/150% #525C6E ·
  기능 카드 #F5F7FA r16 · 안쪽 20 · 아이콘 타일 40 · 줄 사이 20 ·
  "이미 계정이 있어요" 15 Medium #525C6E가 CTA(#1F63E0 r12 h56) **위**.
  위 여백은 시안과 같게 — 로고가 상태바 아래 76(시안 y=120, 상태바 44)에 오도록
  마진 67 + 뿌리 여백 8. 아래 간격(54·21·34)도 시안 그대로이고, CTA만 바닥 고정
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 로고 줄: 방패 41×42 + 워드마크 (색은 IntroActivity가 SpannableString으로) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="67dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="41dp"
                    android:layout_height="42dp"
                    android:contentDescription="GuADian"
                    android:src="@drawable/ic_logo" />

                <TextView
                    android:id="@+id/text_wordmark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.01"
                    android:text="GuADian"
                    android:textColor="@color/wordmark_ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 피그마 00 제목: 28 Bold · 행간 132% · 자간 -1.5% -->
            <TextView
                style="@style/TitleBig"
                android:layout_width="match_parent"
                android:layout_marginTop="54dp"
                android:lineHeight="37sp"
                android:text="광고에서 시작되는\n디지털 피해,\n가족이 함께 예방해요"
                android:textSize="28sp" />

            <TextView
                style="@style/TitleSub"
                android:layout_marginTop="21dp"
                android:text="GuADian이 위험한 광고를 먼저 알려주고\n필요할 때 가족에게 바로 연결해 드려요" />

            <!-- 기능 세 줄이 들어가는 카드 (#F5F7FA r16 · 안쪽 20). 줄: IntroActivity에서 생성 -->
            <LinearLayout
                android:id="@+id/list_features"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="20dp" />
        </LinearLayout>
    </ScrollView>

    <!-- 피그마 00: 링크가 CTA **위** (시안 y727 < 755) · 15 Medium #525C6E 가운데 -->
    <TextView
        android:id="@+id/btn_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/noto_sans_kr_medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="-0.015"
        android:padding="8dp"
        android:text="이미 계정이 있어요"
        android:textColor="@color/ink_soft"
        android:textSize="15sp" />

    <!--
      마진 2 — 위 링크의 안쪽 여백 8이 더해져 글자 사이는 시안과 같은 13이 된다.
      여백을 대신 줄이지 않는 이유는 15 글자만으로는 누를 자리가 모자라서다
    -->
    <Button
        android:id="@+id/btn_start"
        style="@style/BigButton"
        android:layout_marginTop="2dp"
        android:text="안심폰 시작하기" />
</LinearLayout>
