<?xml version="1.0" encoding="utf-8"?>
<!--
  P01 · 보호할 가족 설정 (피그마 v2 · 1036:5).
  시안 좌표: 앱바 뒤로 44(x=7) · 제목 20 Bold(x=52, y=62) → 진행 바 y=112(342×5 r3) +
  "보호자 1 / 4" y=124 → 파란 라벨 14 Bold y=146 → 제목 24 Bold/32 y=172 →
  부제 15 Regular #525C6E y=246 → 카드 #F5F7FA r16 y=296(h209, 아이콘 24 · 제목 16.5 Bold ·
  설명 13.5 Regular · 구분선 1px #E6E9EE) → 안내 14 Regular #8E97A6 **가운데** y=520 →
  Primary 56 r12. 안내는 카드가 아니다 — 시안에서 바탕 없는 회색 한 줄.
  activity_step.xml과 같은 뼈대지만 이 화면만 카드 목록이 고정이라 별도 파일
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_setup"
    android:orientation="vertical"
    android:paddingTop="9dp"
    android:paddingBottom="24dp">

    <!-- 앱바: 피그마 뒤로 화살표 x=7 · 44×44, 제목 x=52 -->
    <LinearLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="7dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="뒤로"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/text_title"
            style="@style/AppBarTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:paddingStart="1dp"
            android:paddingEnd="0dp"
            android:text="보호할 가족 설정" />
    </LinearLayout>

    <!-- 진행 바 + "보호자 1 / 4". Step.progress()에서 채움 -->
    <LinearLayout
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:id="@+id/progress_track"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/progress_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <View
                android:id="@+id/progress_rest"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:includeFontPadding="false"
            android:letterSpacing="-0.015"
            android:text="보호자 1 / 4"
            android:textColor="@color/ink_muted"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="6dp"
            android:paddingEnd="24dp">

            <!-- 시안 1359:6 — 파란 한 줄 라벨 14 Bold #1F63E0 -->
            <TextView
                android:id="@+id/text_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:includeFontPadding="false"
                android:letterSpacing="-0.015"
                android:text="가족을 대신해 미리 준비해요"
                android:textColor="@color/brand_ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_heading"
                style="@style/TitleBig"
                android:layout_width="match_parent"
                android:text="보호할 가족의 휴대폰을\n간단하게 준비해요" />

            <TextView
                android:id="@+id/text_sub"
                style="@style/TitleSub"
                android:layout_marginTop="10dp"
                android:lineHeight="22sp"
                android:text="연결 전에 위험 대응과 알림 범위를 설정할 수 있어요"
                android:textSize="15sp" />

            <!-- 카드: 안쪽 가로 20 · 세로 6 (줄마다 13씩 추가) -->
            <LinearLayout
                android:id="@+id/box_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="6dp"
                android:paddingEnd="20dp"
                android:paddingBottom="6dp" />

            <!-- 시안 1359:24 — 바탕 없는 회색 한 줄, 화면 가운데 -->
            <TextView
                android:id="@+id/text_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:letterSpacing="-0.015"
                android:lineHeight="20sp"
                android:text="연결한 뒤에는 내용을 확인하고 동의만 하면 돼요."
                android:textColor="@color/ink_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_next"
        style="@style/BigButton"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:text="보호 설정 시작하기" />
</LinearLayout>
